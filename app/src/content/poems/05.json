        "wú",
        "shēng",
        "xī",
        "xì",
        "liú"
      ],
      "meaning": "泉眼舍不得出声，水细细地流。",
      "audio": "a1"
    },
    {
      "text": "树阴照水爱晴柔",
      "chars": [
        "树",
        "阴",
        "照",
        "水",
        "爱",
        "晴",
        "柔"
      ],
      "pinyin": [
