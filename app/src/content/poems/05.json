{
  "id": "05",
  "title": "小池",
  "author": "杨万里",
  "dynasty": "宋",
  "lead": "初夏的池塘，水很静，一片刚冒头的小荷叶上站着一只蜻蜓。",
  "lines": [
    {
      "text": "泉眼无声惜细流",
      "chars": [
        "泉",
        "眼",
        "无",
        "声",
        "惜",
        "细",
        "流"
      ],
      "pinyin": [
